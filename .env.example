# =============================================================================
# Toko Amen Snack — Next.js Website & AI Chatbot Environment Variables
# Salin ke .env.local untuk pengembangan lokal, dan atur di Vercel Environment
# =============================================================================

# 1. Koneksi PostgreSQL / Supabase Transaction Pooler (port 6543, read-only aman)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# 2. Vercel AI Gateway (Opsional — tanpa ini Chatbot tetap berjalan dgn mode Smart Catalog Supabase)
# Dapatkan di Vercel Dashboard -> AI Gateway -> API Keys (atau otomatis aktif di Vercel lewat OIDC)
AI_GATEWAY_API_KEY=""
AI_MODEL="google/gemini-3-flash"
